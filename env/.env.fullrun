# Settings of the thesis full run (analyzer + verifier).
#   docker run --env-file env/.env.fullrun ...
# Paths and the vLLM server are machine-specific: set them for your setup.
# Unset values fall back to the defaults in src/config.py.

# EXTENSION_CODE_DIR=/data/extension_code
# DATASETS_DIR=/data/datasets
# RESULTS_ANALYSIS_DIR=/data/results_analysis
# RESULTS_VERIFICATION_DIR=/data/results_verification
# CHROME_BINARY_PATH=/data/chrome-126/chrome-linux64/chrome


LLM_PROVIDER=vllm
# VLLM_HOST=127.0.0.1
# VLLM_PORT=8000
VLLM_TEMPERATURE=0
VLLM_SEED=0
MAX_PROMPT_TOKENS=150000
VLLM_MAX_TOKENS=24000
VLLM_TIMEOUT=1500

VLLM_THINKING_TOKEN_BUDGET=6000


PARALLEL=rolling
PARALLEL_WORKERS=30

PIPELINE_MODE=single_vulnerability

CODE_CONTEXT_MODE=module
CONTEXT_ESCALATION_ORDER=lines,block,module,file

CONTEXT_SHRINK_TO_FIT=all
ANALYZER_CATEGORY_FROM_RULE_ID=true

ANALYZER_PRIORITY_STRATEGY=mmr
ANALYZER_PRIORITY_N=4
ANALYZER_PRIORITY_MMR_LAM=0.8

CONFIDENCE_MAX_LOOPBACKS=1
CONFIDENCE_THRESHOLD_CLASS=0.98
CONFIDENCE_THRESHOLD_SOURCE=0.95

CONFIDENCE_LOOPBACK=argmax
CONFIDENCE_ESCALATE_TRIGGER=both
CONFIDENCE_FAIL_CLASSIFY_NA=false

PROMPT_CACHE_OPTIMIZED=true
PROMPT_CQL_NETWORK_HINT=true

RESULT_RULES=5
ANALYZER_CORRECT_ATTACKER_SOURCE=bidirectional


VERIFIER_FILTER_VULNERABILITY_CATEGORIES=none
VERIFIER_FILTER_STORAGE_APIS=none
VERIFIER_FILTER_MIN_VULNERABILITIES=none
VERIFIER_FILTER_MAX_VULNERABILITIES=none

DETERMINISTIC_EXTENSION_ID=true
USE_LOCAL_VERIFICATION_SERVER=true
ENABLE_DOMAIN_SPOOFING=true

PER_EXTENSION_TIMEOUT=600
STORAGE_POLL=true
WEB_STORAGE_PAGE_ORIGIN=true
VERIFY_DOWNLOADS=true
EXTRA_VERIFY_APIS=all
CAPTURE_FAILURE_ARTIFACTS=false
