# SSH Configuration for Files (Extension Code)
FILES_SSH_HOST=myserver.com
FILES_SSH_PORT=12345
FILES_SSH_USER=name
FILES_SSH_PASSWORD=password

# Gemini API Configuration
GEMINI_API_KEY=mykey-abc1234

# Verifier Browser Mode (optional)
# Accepted values: false (visible window, default), true (classic headless), new (Chrome new headless)
# HEADLESS=false

# USE_LOCAL_VERIFICATION_SERVER=false
# MOCK_SERVER_HOST=example.com
# MOCK_SERVER_PORT=3000

# Verifier Paths / Inputs (optional). Override per Docker run, e.g.:
#   docker run --env-file .env.config1 ...
# Unset/empty values fall back to the defaults in config.py.
# EXTENSION_CODE_DIR=/data/extension_code            # base source code directory
# RESULTS_ANALYSIS_DIR=/data/results_analysis        # where analyzer result-JSONs are read from
# RESULTS_VERIFICATION_DIR=/data/results_verification # base results folder (verifier output)
# CHROME_BINARY_PATH=/usr/bin/google-chrome          # chrome binary for playwright
# RESULTS_TO_VERIFY=results_gemini_2026-02-18_02-09-50 # analysis run to verify ("latest" for newest)

# Verifier Filters (optional). Override the VERIFIER_FILTER dict in config.py.
# List filters accept a single value or a comma-separated list; use "none" to
# disable a filter. Unset/empty falls back to the defaults in config.py.
# VERIFIER_FILTER_VULNERABILITY_CATEGORIES=data_exfiltration
# VERIFIER_FILTER_STORAGE_APIS=none
# VERIFIER_FILTER_MIN_VULNERABILITIES=none
# VERIFIER_FILTER_MAX_VULNERABILITIES=5

# Optional: path to the env file used for this run. When set and readable, the
# verifier copies this exact file into the run folder. With `docker --env-file`
# alone the original path is unknown, so set this if you want the file copied
# (otherwise a reconstructed env_used.env snapshot is written instead).
# ENV_FILE=.env.config1

# Verifier Timeouts (optional, in seconds). Leave unset/empty to use the defaults in config.py.
# PAYLOAD_EXECUTION_TIMEOUT=3
# PAGE_NAVIGATION_TIMEOUT=30
# RETRY_NAVIGATION_TIMEOUT=15
# EXTENSION_CONTEXT_NAVIGATION_TIMEOUT=2
# EXTENSION_ID_DISCOVERY_TIMEOUT=5
# BROWSER_CLOSE_TIMEOUT=10
# PAGE_CLOSE_TIMEOUT=5
