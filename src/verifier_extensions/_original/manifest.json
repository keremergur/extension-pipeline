{
  "manifest_version": 2,
  "name": "Verifier Extension",
  "description": "Extension for security vulnerability verification",
  "version": "1.0",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "<all_urls>",
    "tabs",
    "storage"
  ]
}
